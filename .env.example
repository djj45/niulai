# 复制为 .env（可选）。首次启动时会把这些值写进数据库设置；已存在的设置不会被覆盖。
# 也可以在网页里点「⚙️ 鉴权/设置」直接填，二者等价。

# 业务会话令牌（微信小程序抓包取得，协议文档 §2 ⑤），失效后业务接口返回 200001
NIULAI_CENTRALTOKEN=

# 老师 ID（默认 328，对应聊天室 chatRoomId=298「知行合一交易逻辑专栏」）
NIULAI_TEACHER_ID=328

# 已知房间号可跳过探测
NIULAI_ROOM_ID=

# 腾讯云 IM 凭证（chatroom/getUserSig.htm 下发，通常 60 天有效；有它就能收实时消息）
NIULAI_IM_SDK_APP_ID=1600075223
NIULAI_IM_IDENTIFIER=
NIULAI_IM_USER_SIG=
NIULAI_IM_GROUP_ID=

# Web 服务地址
NIULAI_HOST=127.0.0.1
NIULAI_PORT=5002

# 启动后是否自动把图片/头像补齐到本地（默认开）。
# 补完 data/cache/ 后断网也能翻完整历史；不想让它自动跑就设 0。
MEDIA_AUTOFETCH=1
